% ---------- ARAUS corrigendum ----------
% One page. Issue is 16(2), 2025; the DOI suffix 2024 is the early-access year.
%
% Read and verified 2026-09-29. It corrects the AUTHOR LIST of citation [90] in
% the ARAUS paper: attributed to Gamst, Meyers, Burke and Guarino, actually
% Watson, Clark and Tellegen (the PANAS scales paper). The corrigendum states
% that the DOI and full-text links in the published version already resolved to
% the correct work, so "the error appears to be purely typographical in nature
% and does not affect the study's findings and conclusions".
%
% It therefore touches nothing this paper uses -- not the psychoacoustic
% columns (Navg_r, Savg_r, Ravg_r, Favg_r), not the participant ratings, and
% not the per-person calibration estimates derived from them. Cited alongside
% the dataset paper because IEEE links the two, not because it bears on any
% result here.
%
% The inner quotes are DOUBLE and that is correct, however odd it looks. The
% published title contains the corrected article's title in double quotes, and
% IEEEtran.bst adds its own ``...'' around the whole thing, so the entry ends
% on two closing double quotes. IEEE's own citation export does exactly the
% same:
%
%   K. Ooi et al., "Corrigendum to "ARAUS: A Large-Scale Dataset and Baseline
%   Models of Affective Responses to Augmented Urban Soundscapes"" in IEEE
%   Transactions on Affective Computing, vol. 16, no. 02, pp. 1260-1260,
%   April-June 2025, doi: 10.1109/TAFFC.2024.3435997
%
% These were briefly changed to single quotes on the theory that the doubling
% was our bug. It is not; it is the title. Reproducing what the publisher
% prints is what a reviewer checking against Xplore will expect to see, so
% leave it. Do not "fix" it again.
%
% This note has to live OUT here: BibTeX 0.99 does not allow % inside an entry,
% and its response is to skip the rest of it quietly enough that the reference
% degrades to a bare author dash while the document still compiles with zero
% undefined citations. The .blg says so; the .log does not.
@article{ooi2025corrigendum,
  author = {Ooi, Kenneth and Ong, Zhen-Ting and Watcharasupat, Karn N. and
            Lam, Bhan and Hong, Joo Young and Gan, Woon-Seng},
  title = {Corrigendum to ``{ARAUS}: A Large-Scale Dataset and Baseline Models
           of Affective Responses to Augmented Urban Soundscapes''},
  year = {2025},
  journal = {IEEE Transactions on Affective Computing},
  volume = {16},
  number = {2},
  pages = {1260},
  doi = {10.1109/TAFFC.2024.3435997}
}

